# Copy this file to .env and fill in your real MongoDB Atlas connection string.
# Get this from Atlas: Database > Connect > Drivers > Python
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=research_data

# Comma-separated list of origins allowed to call this API (your Vite dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
